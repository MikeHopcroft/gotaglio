### Test Gotaglio API Endpoints

# Base URL - adjust port if needed
@baseUrl = http://localhost:8000

### Test root endpoint
GET {{baseUrl}}/

###

### Test infer endpoint with mock data
POST {{baseUrl}}/api/infer
Content-Type: application/json

{
  "case":
    {
      "uuid": "1231c4df-bba6-42cd-a3ae-24f31d5503fa",
      "keywords": [
        "add",
        "remove",
        "multi-step"
      ],
      "cart": {
        "items": []
      },
      "turns": [
        {
          "user": "I'll have a grande vanilla latte",
          "expected": {
            "items": [
              {
                "name": "latte",
                "quantity": 1,
                "size": "grande",
                "options": [
                  {
                    "name": "vanilla syrup",
                    "amount": "regular"
                  }
                ]
              }
            ]
          }
        },
        {
          "user": "Actually make that nonfat and decaf",
          "expected": {
            "items": [
              {
                "name": "latte",
                "quantity": 1,
                "size": "grande",
                "options": [
                  {
                    "name": "vanilla syrup"
                  },
                  {
                    "name": "decaf",
                    "quantity": 1
                  },
                  {
                    "name": "nonfat milk",
                    "quantity": 1
                  }
                ]
              }
            ]
          }
        }
      ]
    },
  "turn": 0
}

###

### Test infer endpoint with different turn
POST {{baseUrl}}/api/infer
Content-Type: application/json

{
  "case": {
    "id": "test-case-456",
    "description": "Another test case",
    "metadata": {
      "source": "test"
    }
  },
  "turn": 3
}

###

### Test validate endpoint with valid data
POST {{baseUrl}}/api/validate
Content-Type: application/json

{
  "case": {
    "id": "validation-test",
    "type": "test"
  },
  "some_field": "some_value",
  "nested": {
    "property": "value"
  }
}

###

### Test validate endpoint with missing case field (should return error)
POST {{baseUrl}}/api/validate
Content-Type: application/json

{
  "some_field": "some_value",
  "no_case_field": true
}

###

### Test validate endpoint with empty data (should return error)
POST {{baseUrl}}/api/validate
Content-Type: application/json

{}
